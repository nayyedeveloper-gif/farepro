{
  "expo": {
    "name": "TeamLink Driver",
    "slug": "teamlink-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teamwork",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiUrl": "https://teamwork.29jewellery.com/api",
      "wsUrl": "wss://teamwork.29jewellery.com/ws"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.nayyemaung.teamlink.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Teamwork uses your location to share fleet position on channel maps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.nayyemaung.teamlink.driver"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Teamwork to access your photos to send images.",
          "cameraPermission": "Allow Teamwork to use your camera."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Teamwork to use your microphone for voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF",
          "sounds": [],
          "ios": {
            "permissions": {
              "alert": true,
              "badge": true,
              "sound": true
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Teamwork to show your location on fleet maps."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
